# Backend HTTP port
BACKEND_PORT=3000

# Absolute or cwd-relative path to the SQLite database file
SQLITE_PATH=./data/mmfv.sqlite

# Absolute or cwd-relative path to the seed JSON (used when the DB is empty)
SQLITE_SEED_FILE=./seed/movies.json

# TMDB API Read Access Token (Bearer token for Authorization header)
TMDB_API_KEY=your.api.read.access.token
