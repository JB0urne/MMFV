{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "mmfv-frontend",
    "root": "apps/mmfv-frontend",
    "sourceRoot": "apps/mmfv-frontend/src",
    "projectType": "application",
    "tags": ["scope:frontend", "type:app"],
    "targets": {
        "serve": {
            "executor": "nx:run-commands",
            "options": {
                "command": "ng serve",
                "cwd": "apps/mmfv-frontend"
            }
        },
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "ng build",
                "cwd": "apps/mmfv-frontend"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "options": {
                "lintFilePatterns": ["apps/mmfv-frontend/**/*.ts"]
            }
        }
    }
}
