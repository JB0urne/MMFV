{
    "name": "mmfv-backend",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/mmfv-backend/src",
    "projectType": "application",
    "tags": ["backend", "nest"],
    "targets": {
        "build": {
            "executor": "@nx/js:tsc",
            "options": {
                "outputPath": "dist/apps/mmfv-backend",
                "main": "src/main.ts",
                "tsConfig": "apps/mmfv-backend/tsconfig.json",
                "rootDir": ".",
                "outputFileName": "apps/mmfv-backend/src/main.js",
                "generatePackageJson": true
            },
            "outputs": ["{options.outputPath}"]
        },
        "serve": {
            "executor": "@nx/js:node",
            "options": {
                "buildTarget": "mmfv-backend:build"
            },
            "continuous": true
        }
    }
}
