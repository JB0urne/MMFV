{
    "name": "mmfv-backend",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/mmfv-backend/src",
    "projectType": "application",
    "tags": ["backend", "nest"],
    "targets": {
        "build": {
            "executor": "@nx/webpack:webpack",
            "options": {
                "outputPath": "dist/apps/mmfv-backend",
                "main": "apps/mmfv-backend/src/main.ts",
                "tsConfig": "apps/mmfv-backend/tsconfig.json",
                "buildLibsFromSource": true,
                "target": "node",
                "compiler": "tsc",
                "generatePackageJson": true,
                "webpackConfig": "apps/mmfv-backend/webpack.config.js"
            },
            "outputs": ["{options.outputPath}"]
        },
        "serve": {
            "executor": "@nx/js:node",
            "options": {
                "buildTarget": "mmfv-backend:build"
            },
            "continuous": true
        }
    }
}
