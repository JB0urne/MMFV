{
    "name": "mmfv-backend",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/mmfv-backend/src",
    "projectType": "application",
    "tags": ["backend", "nest"],
    "targets": {
        "build": {
            "executor": "@nx/esbuild:esbuild",
            "outputs": ["{options.outputPath}"],
            "options": {
                "platform": "node",
                "outputPath": "dist/apps/mmfv-backend",
                "outputFileName": "main.js",
                "format": ["cjs"],
                "bundle": true,
                "thirdParty": false,
                "main": "apps/mmfv-backend/src/main.ts",
                "tsConfig": "apps/mmfv-backend/tsconfig.app.json",
                "generatePackageJson": true,
                "esbuildConfig": "apps/mmfv-backend/esbuild.config.cjs"
            }
        },
        "serve": {
            "executor": "@nx/js:node",
            "options": {
                "buildTarget": "mmfv-backend:build"
            },
            "continuous": true
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        }
    }
}
