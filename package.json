{
  "name": "mmfv-monorepo",
  "version": "1.0.0",
  "description": "Monorepo with Angular frontend and NestJS backend, both in TypeScript",
  "scripts": {
    "nx": "nx",
    "backend:down": "docker compose down",
    "backend:dev": "cd apps/mmfv-backend && nest start --watch",
    "frontend": "cd apps/mmfv-frontend && ng serve",
    "mongodb:start": "docker compose up -d mongodb",
    "mongodb:reset": "./mongodb/scripts/reset-and-import.sh",
    "dev": "./scripts/start-dev.sh",
    "dev:simple": "./scripts/start-dev-simple.sh",
    "backend:build": "cd apps/mmfv-backend && nest build",
    "frontend:build": "cd apps/mmfv-frontend && ng build",
    "build": "npm run backend:build && npm run frontend:build"
  },
  "keywords": [
    "angular",
    "nestjs",
    "typescript",
    "monorepo",
    "fullstack"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@angular/animations": "^18.0.0",
    "@angular/common": "^18.0.0",
    "@angular/compiler": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@angular/forms": "^18.0.0",
    "@angular/platform-browser": "^18.0.0",
    "@angular/platform-browser-dynamic": "^18.0.0",
    "@angular/router": "^18.0.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "mongoose": "^8.19.2",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.0",
    "zone.js": "^0.14.9"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.0.0",
    "@angular/cli": "^18.0.0",
    "@angular/compiler-cli": "^18.0.0",
    "@nestjs/cli": "^10.3.0",
    "@nx/workspace": "^22.0.2",
    "@types/express": "^4.17.21",
    "@types/jasmine": "^5.1.4",
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "jasmine-core": "^5.1.2",
    "karma": "^6.4.3",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "nx": "^22.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}
