{
    "name": "mmfv-monorepo",
    "version": "1.0.0",
    "description": "Monorepo with Angular frontend and NestJS backend, both in TypeScript",
    "scripts": {
        "nx": "nx",
        "backend:down": "docker compose down",
        "backend:dev": "cd apps/mmfv-backend && nest start --watch",
        "frontend": "cd apps/mmfv-frontend && ng serve",
        "mongodb:start": "docker compose up -d mongodb",
        "mongodb:reset": "./mongodb/scripts/reset-and-import.sh",
        "backend": "./scripts/start-dev.sh",
        "backend:build": "cd apps/mmfv-backend && nest build",
        "frontend:build": "cd apps/mmfv-frontend && ng build",
        "build": "npm run backend:build && npm run frontend:build"
    },
    "keywords": [
        "angular",
        "nestjs",
        "typescript",
        "monorepo",
        "fullstack"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@angular/animations": "^21.0.0",
        "@angular/cdk": "^21.0.0",
        "@angular/common": "^21.0.0",
        "@angular/compiler": "^21.0.0",
        "@angular/core": "^21.0.0",
        "@angular/forms": "^21.0.0",
        "@angular/material": "^21.0.0",
        "@angular/platform-browser": "^21.0.0",
        "@angular/platform-browser-dynamic": "^21.0.0",
        "@angular/router": "^21.0.0",
        "@nestjs/common": "^10.3.0",
        "@nestjs/core": "^10.3.0",
        "@nestjs/mongoose": "^11.0.3",
        "@nestjs/platform-express": "^10.3.0",
        "mongoose": "^8.19.2",
        "reflect-metadata": "^0.1.14",
        "rxjs": "^7.8.1",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/cli": "^21.0.0",
        "@angular/compiler-cli": "^21.0.0",
        "@nestjs/cli": "^11.0.12",
        "@nx/angular": "^22.1.0",
        "@nx/workspace": "^22.0.2",
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.0",
        "nx": "^22.0.2",
        "prettier": "3.6.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.0"
    }
}
